# SPDX-License-Identifier: AGPL-3.0-only
# Minimal xb-social image . Build context is servers/xbox-live:
#   podman build -f deploy/docker/Dockerfile.xb-social -t ghcr.io/openpak/xb-social:<tag> .
# Pure Go (CGO off), static binary, no shell, non-root. Pin the base by digest in CI.
ARG GO_IMAGE=docker.io/library/golang:1.26-bookworm
FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS build
ARG TARGETOS TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY internal ./internal
COPY services/xb-social ./services/xb-social
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} \
    go build -trimpath -ldflags="-s -w" -o /out/xb-social ./services/xb-social/cmd/xb-social

FROM scratch
COPY --from=build /out/xb-social /xb-social
USER 10001:10001
ENTRYPOINT ["/xb-social"]
