# SPDX-License-Identifier: AGPL-3.0-only
# Minimal xb-auth image. Build context is servers/xbox-live (the Go module root):
#   podman build -f deploy/docker/Dockerfile.xb-auth -t ghcr.io/openpak/xb-auth:<tag> .
# Pure Go (CGO off), static binary, no shell, non-root. Pin the base by digest in CI.
ARG GO_IMAGE=docker.io/library/golang:1.26-bookworm
FROM ${GO_IMAGE} AS build
ARG TARGETOS TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY internal ./internal
COPY services/xb-auth ./services/xb-auth
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} \
    go build -trimpath -ldflags="-s -w" -o /out/xb-auth ./services/xb-auth/cmd/xb-auth

FROM scratch
COPY --from=build /out/xb-auth /xb-auth
USER 10001:10001
ENTRYPOINT ["/xb-auth"]
