# SPDX-License-Identifier: AGPL-3.0-only
# Minimal xb-enroll image (public device-pairing front). Build context is servers/xbox-live:
#   podman build -f deploy/docker/Dockerfile.xb-enroll -t ghcr.io/openpak/xb-enroll:<tag> .
# Pure Go (CGO off), static binary, no shell, non-root. Pin the base by digest in CI.
ARG GO_IMAGE=docker.io/library/golang:1.26-bookworm
FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS build
ARG TARGETOS TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY internal ./internal
COPY services/xb-enroll ./services/xb-enroll
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} \
    go build -trimpath -ldflags="-s -w" -o /out/xb-enroll ./services/xb-enroll/cmd/xb-enroll

FROM scratch
COPY --from=build /out/xb-enroll /xb-enroll
USER 10001:10001
ENTRYPOINT ["/xb-enroll"]
