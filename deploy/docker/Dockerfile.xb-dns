# Minimal xb-dns image. Build context is servers/xbox-live (the Go module root):
#   podman build -f deploy/docker/Dockerfile.xb-dns -t ghcr.io/openpak/xb-dns:<tag> .
# Pure Go (CGO off), static binary, no shell, non-root. Pin the base by digest in CI.
ARG GO_IMAGE=docker.io/library/golang:1.26-bookworm
FROM ${GO_IMAGE} AS build
ARG TARGETOS TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY internal ./internal
COPY services/xb-dns ./services/xb-dns
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} \
    go build -trimpath -ldflags="-s -w" -o /out/xb-dns ./services/xb-dns/cmd/xb-dns

FROM scratch
COPY --from=build /out/xb-dns /xb-dns
USER 10001:10001
ENTRYPOINT ["/xb-dns"]
