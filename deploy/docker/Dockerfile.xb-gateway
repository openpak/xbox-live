# SPDX-License-Identifier: AGPL-3.0-only
# Minimal xb-gateway image. Build context is servers/xbox-live (the Go module root):
#   podman build -f deploy/docker/Dockerfile.xb-gateway -t ghcr.io/openpak/xb-gateway:<tag> .
# Pure Go (CGO off), static binary, no shell, non-root. Pin the base by digest in CI.
ARG GO_IMAGE=docker.io/library/golang:1.26-bookworm
FROM --platform=$BUILDPLATFORM ${GO_IMAGE} AS build
ARG TARGETOS TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY internal ./internal
COPY services/xb-gateway ./services/xb-gateway
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} \
    go build -trimpath -ldflags="-s -w" -o /out/xb-gateway ./services/xb-gateway/cmd/xb-gateway

FROM scratch
COPY --from=build /out/xb-gateway /xb-gateway
USER 10001:10001
ENTRYPOINT ["/xb-gateway"]
# Container health is listener liveness only; see /readyz and /healthz for dependencies and e2e.
EXPOSE 3074/udp
