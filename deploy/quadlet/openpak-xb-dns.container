# MAIN host. Exact-name Xbox discovery behind the established OpenPak resolver, which
# forwards as/macs/tgs(.part).xboxlive.com here. Not a recursive resolver. Binds
# loopback only (host network) by default; never publishes public UDP 53.
[Unit]
Description=OpenPak Xbox discovery DNS

[Container]
ContainerName=openpak-xb-dns
Image=ghcr.io/openpak/xb-dns@sha256:REPLACE_WITH_DIGEST
Network=host
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
User=10001:10001
EnvironmentFile=%h/openpak/deploy/xbox/xb-dns.env
# no shell in the scratch image, so podman cannot run a HealthCmd; use /healthz on loopback
HealthCmd=none

[Service]
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
