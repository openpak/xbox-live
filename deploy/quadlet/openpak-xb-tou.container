# MAIN host (quilted-waffle). Service 11 (Terms of Use / country files), private
# gRPC feature stream published on the ZeroTier address only; the secondary
# gateway reaches it with XBGW_BACKENDS=11=10.212.63.196:26112 (mTLS).
[Unit]
Description=OpenPak Xbox Terms of Use and country files (service 11)
After=network-online.target

[Container]
ContainerName=openpak-xb-tou
Image=localhost/xb-tou:test-20261016-arm64
Network=openpak.network
IP=REPLACE_IP
PublishPort=10.212.63.196:26112:26112/tcp
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
User=10001:10001
EnvironmentFile=%h/openpak/deploy/xbox/xb-tou.env
Volume=%h/openpak/deploy/xbox/pki/tou:/run/xb:ro

[Service]
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
