XB_TOU_ADDR=0.0.0.0:26112
XB_TLS_CERT_FILE=/run/xb/tou.crt
XB_TLS_KEY_FILE=/run/xb/tou.key
XB_CLIENT_CA_FILE=/run/xb/client-ca.crt
