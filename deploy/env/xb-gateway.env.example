# xb-gateway configuration. No secrets here: key material is mounted as files.
# Copy to ~/openpak/deploy/xbox/xb-gateway.env on the SECONDARY host.

# Local interface the UDP socket binds. The public IP is NAT-ed and not a local
# address on this host, so do not put it here.
XBGW_BIND=0.0.0.0:3074
# Public IPv4 consoles reach; must equal the address xb-auth puts in tickets.
# Private/ZeroTier addresses are rejected at startup.
XBGW_ADVERTISE_IP=145.241.228.207
# Loopback only. Confirm the port is free on the secondary before first start.
XBGW_HEALTH_ADDR=127.0.0.1:3075

# xb-account (main host, ZeroTier address) over mutual TLS. Server cert must carry
# this name; the gateway's client cert must have URI SAN spiffe://openpak/xb-gateway.
XBGW_ACCOUNT_URL=https://10.212.63.196:REPLACE_PORT
XBGW_ACCOUNT_SERVER_NAME=xb-account.openpak.internal
XBGW_MTLS_CERT=/run/xb/gateway.crt
XBGW_MTLS_KEY=/run/xb/gateway.key
XBGW_MTLS_CA=/run/xb/ca.crt

# Feature backends: <service id>=<host:port> (gRPC over the same mTLS). Leave empty
# until a feature service exists: unlisted services answer native "unavailable".
XBGW_BACKENDS=

# SG keyring shared with xb-auth (its XB_SG_KEYRING_FILE): {"active":N,"keys":{"N":"<32 hex>"}}, mode 0600.
XBGW_SG_KEYRING_FILE=/run/xb/sg-keyring.json

# Limits (defaults shown).
XBGW_MAX_SESSIONS=4096
XBGW_MAX_SESSIONS_PER_IP=8
XBGW_INIT_RATE_PER_IP=2
XBGW_INIT_WORKERS=16
XBGW_PACKET_RATE=300
XBGW_IDLE_TIMEOUT=60s
XBGW_MAX_LIFETIME=8h

# DEBUG ONLY, off by default. Writes DECRYPTED traffic to disk; never enable on
# the production host with real accounts. Needs a directory outside the shared RAM disk
# (the quadlet root filesystem is read-only: add a Volume if you really need it).
# XBGW_DEBUG_CAPTURE=1
# XBGW_CAPTURE_DIR=/var/capture
