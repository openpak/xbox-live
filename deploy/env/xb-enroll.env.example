# xb-enroll configuration. No secrets in this file: the client key is a file under /run/xb.
# Plain HTTP listener: put TLS (Traefik) in front, route ONLY PathPrefix(`/v1/`) to it.
XBE_LISTEN_ADDR=0.0.0.0:8080
# xb-account's mTLS listener (private) and the CA that signs its server certificate.
XBE_ACCOUNT_URL=https://REPLACE_ACCOUNT_HOST:REPLACE_PORT
XBE_ACCOUNT_CA_FILE=/run/xb/account-ca.crt
XBE_ACCOUNT_SERVER_NAME=REPLACE_SERVER_CERT_NAME
# Client identity: certificate with URI SAN spiffe://openpak/xb-enroll signed by the
# CA xb-account trusts as XB_CLIENT_CA_FILE. Narrowly scoped: it can only reach the
# two enrolment routes.
XBE_CLIENT_CERT_FILE=/run/xb/client.crt
XBE_CLIENT_KEY_FILE=/run/xb/client.key
# Reverse proxies whose X-Forwarded-For is trusted for per-IP limits (the Traefik
# container network). Empty = ignore the header (every caller looks like the proxy).
XBE_TRUSTED_PROXIES=REPLACE_PROXY_CIDR
