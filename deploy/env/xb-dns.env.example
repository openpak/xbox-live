# xb-dns configuration. No secrets.
# Address of the main xb-auth listener that as/macs/tgs names resolve to (public IPv4).
XBDNS_AUTH_IP=REPLACE_MAIN_AUTH_IPV4
# Optional per-name overrides ("name ip" lines, only the six Xbox auth names allowed).
#XBDNS_TABLE_FILE=/run/xb/dns-table.txt
# Default is loopback high port; the established resolver forwards here. Do NOT bind public :53.
XBDNS_BIND=127.0.0.1:5353
XBDNS_HEALTH=127.0.0.1:5354
XBDNS_RATE=20
XBDNS_BURST=40
