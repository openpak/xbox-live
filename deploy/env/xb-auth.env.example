# xb-auth configuration. Variable names are provisional until services/xb-auth/cmd
# exists; the contract that must hold is fixed in deploy/README.md.
XBAUTH_ACCOUNT_URL=https://openpak-xb-account:REPLACE_PORT
XBAUTH_MTLS_CERT=/run/xb/auth.crt
XBAUTH_MTLS_KEY=/run/xb/auth.key
XBAUTH_MTLS_CA=/run/xb/ca.crt
# Gateway address written into issued tickets: the SECONDARY PUBLIC IPv4.
XBAUTH_GATEWAY_ADVERTISE_IP=145.241.228.207
# Ticket validation key shared with xb-gateway + rotation id.
XBAUTH_TICKET_KEY_FILE=/run/xb-ticket/ticket.key
XBAUTH_TICKET_KEY_ID=
