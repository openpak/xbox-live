# xb-auth configuration (names match services/xb-auth/cmd). No secrets: every
# key is a file mounted under /run/xb.
XB_AUTH_UDP_ADDR=0.0.0.0:8888   # container side; host UDP 88 is published to it
XB_AUTH_HEALTH_ADDR=0.0.0.0:8088
# Gateway address written into issued tickets: the SECONDARY PUBLIC IPv4.
XB_GATEWAY_PUBLIC_IPV4=145.241.228.207
XB_TGS_KEYRING_FILE=/run/xb/tgs.keyring.json
XB_SG_KEYRING_FILE=/run/xb/sg.keyring.json
XB_USER_KEY_SECRETS_FILE=/run/xb/user-key-secrets.json
XB_ACCOUNT_URL=https://openpak-xb-account:26111
XB_ACCOUNT_CA_FILE=/run/xb/ca.crt
XB_TLS_CERT_FILE=/run/xb/auth.crt
XB_TLS_KEY_FILE=/run/xb/auth.key
